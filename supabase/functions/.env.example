# Variáveis das Edge Functions — copie para supabase/functions/.env (local) e use
# `supabase secrets set` no remoto. Nunca versione valores reais.

# Origens web liberadas no CORS, separadas por vírgula (o app nativo não precisa).
# Ex.: http://localhost:8081
CORS_ORIGENS_PERMITIDAS=

# Mercado Pago, API de Orders (T22). Use SÓ o Access Token de TESTE da aplicação "CampusShare"
# (Suas integrações > Testes > Credenciais de teste). Ele começa com APP_USR-, como o de produção:
# confira que é o de teste. Nunca versione o valor; no remoto: `supabase secrets set`.
MERCADO_PAGO_ACCESS_TOKEN=

# true (padrão): o pagador vai como first_name "APRO" e e-mail de teste, e o sandbox aprova o Pix
# sozinho. false: usa o e-mail e o nome do usuário (não usar no MVP).
MERCADO_PAGO_MODO_TESTE=true

# Assinatura secreta do webhook (T23): painel do Mercado Pago > CampusShare > Webhooks >
# Configurar notificações (evento Order). Valida o x-signature das notificações. Nunca versione.
MERCADO_PAGO_WEBHOOK_SECRET=
